{
  "name": "@capxul/generate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node --experimental-strip-types --no-warnings src/main.ts",
    "seed": "node --experimental-strip-types --no-warnings src/seed.ts",
    "delta:check": "node --experimental-strip-types --no-warnings src/delta.entry.ts",
    "ratchets": "node --experimental-strip-types --no-warnings src/ratchets.entry.ts",
    "words": "node --experimental-strip-types --no-warnings src/words.entry.ts",
    "types": "effect-tsgo tsc -p .",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts"
  },
  "dependencies": {
    "@capxul/blueprint": "workspace:*",
    "@capxul/blueprint-tools": "workspace:*",
    "effect": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
