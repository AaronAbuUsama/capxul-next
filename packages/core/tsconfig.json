{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // Core serves the blueprint's Rpc groups over HTTP and keeps its spans through SQL. Effect 4 ships Rpc, HTTP
        // and SQL only under effect/rpc, effect/http and effect/sql, marked unstable, with no stable replacement. The
        // catalog's exact pin of effect is the guard, as in packages/blueprint.
        // `@effect/sql-pg` is the same SQL at the Postgres driver: Core's chain operations need its `json` for jsonb.
        // `effect/observability` is Effect's own OTLP export (src/telemetry/export.ts), likewise only unstable.
        "allowedUnstableApis": ["effect/rpc", "effect/http", "effect/sql", "@effect/sql-pg", "effect/observability"]
      }
    ]
  },
  "include": ["alchemy.run.ts", "src", "test"]
}
