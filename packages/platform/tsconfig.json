{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        // Effect 4 ships these only as unstable modules, with no stable replacement: child processes (`docker diff` in
        // the drift check), the file system (run records, token files), WebCrypto's HMAC and digest (the site token)
        // and Bun's runtime, which Alchemy needs; OTLP export (src/telemetry.ts), which Effect ships only under
        // effect/observability, and the HTTP client it sends with. The catalog's exact pin of effect is the guard.
        "allowedUnstableApis": [
          "effect/process",
          "effect/FileSystem",
          "effect/crypto",
          "@effect/platform-bun",
          "effect/observability",
          "effect/http"
        ]
      }
    ]
  },
  "include": ["alchemy.run.ts", "host.run.ts", "src", "bootstrap", "test"]
}
