# The smallest bench that can prove the world clock: pinned Frappe, pinned ERPNext, pinned HRMS and the capxul app, no
# built assets. HRMS is here for the payroll report the thin line's report.run 2 asks for (Site.REPORTS.payroll).
# ERPNext is here only because the capxul app does not install without it (its custom fields sit on Supplier, Customer,
# Employee, GL Entry and Payment Entry: `install-app capxul` on Frappe alone ends "Could not find DocType: Supplier").
# Built by the platform stack (src/bench.ts) with the pins from packages/bench-image/apps.lock.json, which bin/run.sh reads.
# First built by the bench clocks spike (packages/frappe-app/records/bench-clocks); the hosted six-app image is packages/bench-image.
ARG BUILD_IMAGE
FROM ${BUILD_IMAGE}
USER frappe
WORKDIR /home/frappe
ARG FRAPPE_URL
ARG FRAPPE_TAG
ARG FRAPPE_COMMIT
COPY --chown=frappe:0 image-build.sh /opt/bench/image-build.sh
# build_ca is optional: behind a TLS-inspecting proxy the proxy's CA is passed as a secret and never enters a layer.
RUN --mount=type=secret,id=build_ca,uid=1000,required=false \
    bash /opt/bench/image-build.sh init "$FRAPPE_URL" "$FRAPPE_TAG" "$FRAPPE_COMMIT"
ARG ERPNEXT_URL
ARG ERPNEXT_COMMIT
RUN --mount=type=secret,id=build_ca,uid=1000,required=false \
    bash /opt/bench/image-build.sh erpnext "$ERPNEXT_URL" "$ERPNEXT_COMMIT"
ARG HRMS_URL
ARG HRMS_COMMIT
RUN --mount=type=secret,id=build_ca,uid=1000,required=false \
    bash /opt/bench/image-build.sh hrms "$HRMS_URL" "$HRMS_COMMIT"
COPY --from=capxul-app --chown=frappe:0 . /home/frappe/frappe-bench/apps/capxul
RUN --mount=type=secret,id=build_ca,uid=1000,required=false \
    bash /opt/bench/image-build.sh app
WORKDIR /home/frappe/frappe-bench
# Every Python process of the bench loads the world clock before Frappe can read the time (capxul/boot.py).
RUN env/bin/python -c "import capxul.boot as b; print(b.write_pth())"
