# The site door: the bench's image (bench/Containerfile) plus door.py and its bench half, sites.py. It runs in its own container on the bench,
# shares the sites volume with web, worker and scheduler, and is the only process that creates sites.
ARG BENCH_IMAGE
FROM ${BENCH_IMAGE}
COPY --chown=frappe:0 door.py /opt/door/door.py
COPY --chown=frappe:0 sites.py /opt/door/sites.py
