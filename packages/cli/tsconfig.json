{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        // The command line is Effect's CLI module over the SDK's Rpc client, run by Effect's Node platform:
        // effect/cli, effect/rpc, effect/http, FileSystem, Stdio and @effect/platform-node, which Effect 4 marks unstable with no stable
        // replacement. A call made through it in this process (src/call.ts) stands in for a process's Path, Terminal and
        // child processes, which effect/cli requires and Effect 4 marks the same. The catalog's exact pins are the guard, as in packages/blueprint.
        "allowedUnstableApis": [
          "effect/cli",
          "effect/rpc",
          "effect/http",
          "effect/FileSystem",
          "effect/Stdio",
          "effect/Path",
          "effect/Terminal",
          "effect/process",
          "@effect/platform-node"
        ]
      }
    ]
  },
  "include": ["src", "test"]
}
