{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The runner runs under Bun (run.sh), and type-checks Core's Worker, which it deploys.
    "types": ["node", "bun", "@cloudflare/workers-types"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // The runner calls the blueprint's Rpc groups over HTTP, and reads and writes files under Bun. Effect 4 ships
        // Rpc, HTTP, the file system, paths and its Bun platform only as unstable modules, with no stable replacement.
        // The catalog's exact pin of effect is the guard, as in packages/blueprint. A local Core (src/local) also needs
        // sockets (its database bridge) and child processes (workerd), which Effect 4 ships only as unstable modules
        // too, Bun's through the shared Node ones. A test serves the SDK's TestDoor with
        // @effect/platform-node's HTTP server, as the SDK's and the command line's tests do. test/kept-facts.test.ts
        // reads kept facts from a real Postgres through SQL, as Core does.
        "allowedUnstableApis": [
          "effect/rpc",
          "effect/http",
          "effect/FileSystem",
          "effect/Path",
          "effect/socket",
          "effect/net",
          "effect/process",
          "@effect/platform-bun",
          "@effect/platform-node",
          "@effect/platform-node-shared",
          "effect/sql",
          // OTLP export at the entry (packages/platform, src/telemetry.ts), shipped only under effect/observability.
          "effect/observability"
        ]
      }
    ]
  },
  "include": ["src", "test"]
}
