{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The door, the chain and the index run inside Cloudflare Workers and Durable Objects.
    "types": ["node", "@cloudflare/workers-types"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // Effect 4 ships these only as unstable modules, with no stable replacement: the HTTP client and server
        // (calls to the door, Neon and Cloudflare; the Workers' answers), the command line, the file system (records
        // and migrations), child processes (the proofs run the command line as a person does) and Bun's runtime,
        // which Alchemy needs, and Rpc, with which the platform serves the blueprint's platform group (src/platform);
        // paths and digests too, with which a deploy fingerprints an image's inputs (src/stack/images.ts), and Node's
        // platform services, which the tests that read files run on; and SQL, with which test/old-rows.test.ts reads
        // rows written by earlier code from a real Postgres, as Core does.
        // The catalog's exact pin of effect is the guard.
        // Effect's OTLP exporter (`effect/observability`, roadmap 4.4) is unstable too: the world exports its telemetry with it.
        "allowedUnstableApis": [
          "effect/http",
          "effect/cli",
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/crypto",
          "effect/process",
          "@effect/platform-bun",
          "@effect/platform-node",
          "effect/rpc",
          "effect/sql",
          "effect/observability"
        ]
      }
    ]
  },
  "include": ["alchemy.run.ts", "src", "test"]
}
