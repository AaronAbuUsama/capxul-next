{
  "key": [
    "world_id"
  ],
  "checks": [
    "CHECK ((chain_id > 0))",
    "CHECK ((clock_mode = ANY (ARRAY['frozen'::text, 'running'::text])))",
    "CHECK ((epoch > 0))",
    "CHECK ((kind = ANY (ARRAY['local'::text, 'simulated'::text, 'staging'::text, 'production'::text])))",
    "CHECK (((parent_seq IS NULL) OR (parent_seq >= 0)))",
    "CHECK ((profile = ANY (ARRAY['core'::text, 'full'::text])))",
    "CHECK (((rate >= 1) AND (rate <= 60)))",
    "CHECK ((state = ANY (ARRAY['creating'::text, 'running'::text, 'stopped'::text, 'restoring'::text, 'parked'::text, 'closed'::text])))",
    "CHECK ((world_id ~ '^[a-z][a-z0-9]{0,11}$'::text))"
  ],
