{
  "name": "capxul-next",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -b packages/book",
    "test": "pnpm --filter @capxul/book test && pnpm --filter @capxul/portal test",
    "book": "node --experimental-strip-types packages/book/src/main.ts books/target/index.ts /tmp/target",
    "frozen": "node --experimental-strip-types tools/check-frozen.ts",
    "judgments": "node --experimental-strip-types tools/report-judgments.ts",
    "portal": "node --experimental-strip-types --no-warnings packages/portal/src/main.ts generate packages/portal/dist",
    "portal:check": "node --experimental-strip-types --no-warnings packages/portal/src/main.ts check",
    "contracts:test": "pnpm --filter @capxul/contracts test",
    "contracts:fork": "pnpm --filter @capxul/contracts fork",
    "contracts:prove": "pnpm --filter @capxul/contracts prove",
    "sdk:test": "pnpm --filter @capxul/sdk test",
    "devnet:test": "pnpm --filter @capxul/devnet test"
  },
  "devDependencies": {
    "effect": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
