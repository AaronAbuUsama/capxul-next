{
  "name": "capxul-next",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm shape && pnpm types && pnpm test",
    "shape": "pnpm --filter @capxul/lint shape",
    "types": "pnpm --filter @capxul/lint check && pnpm --filter @capxul/indexer check",
    "test": "pnpm --filter @capxul/lint test && pnpm frappe:test",
    "frappe:test": "python3 -m unittest discover -s packages/frappe-app/tests"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
