{
  "name": "capxul-next",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -b packages/blueprint-engine",
    "test": "pnpm --filter @capxul/blueprint-engine test && pnpm --filter @capxul/portal test && pnpm record:test && pnpm contracts:check-blueprint:test && pnpm frappe:check-blueprint:test && pnpm frappe:check-blueprint && pnpm evals:test && pnpm plan:test && pnpm plan:check && pnpm tasks:check && pnpm evals:check && pnpm layout:test && pnpm layout",
    "record:test": "node --experimental-strip-types --test spikes/skeleton/core/test/record-schema.test.ts spikes/skeleton/core/test/record-runtime.test.ts",
    "blueprint": "node --experimental-strip-types packages/blueprint-engine/src/main.ts blueprint/index.ts var/blueprint",
    "frozen": "node --experimental-strip-types packages/blueprint-engine/scripts/check-frozen.ts",
    "judgments": "node --experimental-strip-types packages/blueprint-engine/scripts/report-judgments.ts",
    "portal": "node --experimental-strip-types --no-warnings packages/portal/src/main.ts generate packages/portal/dist",
    "portal:check": "node --experimental-strip-types --no-warnings packages/portal/src/main.ts check",
    "contracts:test": "pnpm --filter @capxul/contracts test",
    "contracts:check-blueprint": "node --experimental-strip-types --no-warnings packages/contracts/abi-check/main.ts",
    "blueprint:ripple": "node --experimental-strip-types --no-warnings packages/blueprint-engine/scripts/ripple.ts",
    "frappe:check-blueprint": "node --experimental-strip-types --no-warnings packages/frappe-app/blueprint-check/main.ts",
    "frappe:check-blueprint:test": "node --experimental-strip-types --no-warnings --test packages/frappe-app/blueprint-check/check.test.ts",
    "contracts:check-blueprint:test": "node --experimental-strip-types --no-warnings --test packages/contracts/abi-check/abi-check.test.ts",
    "contracts:export-abi": "node --experimental-strip-types --no-warnings packages/contracts/abi-check/export-abi.ts",
    "contracts:fork": "pnpm --filter @capxul/contracts fork",
    "contracts:prove": "pnpm --filter @capxul/contracts prove",
    "sdk:test": "pnpm --filter @capxul/sdk test",
    "devnet:test": "pnpm --filter @capxul/devnet test",
    "plan": "node --experimental-strip-types --no-warnings packages/plan/src/main.ts",
    "plan:test": "node --experimental-strip-types --no-warnings --test packages/plan/src/modules/plan/plan.test.ts",
    "plan:check": "node --experimental-strip-types --no-warnings packages/plan/src/main.ts check",
    "tasks": "node --experimental-strip-types packages/plan/src/tasks.ts",
    "tasks:check": "node --experimental-strip-types packages/plan/src/tasks.ts --check",
    "layout": "node --experimental-strip-types --no-warnings packages/layout/src/main.ts",
    "layout:test": "node --experimental-strip-types --no-warnings --test packages/layout/src/modules/layout/layout.test.ts",
    "portal:serve": "node --experimental-strip-types --no-warnings packages/portal/src/main.ts serve",
    "evals": "node --experimental-strip-types --no-warnings packages/evals/src/main.ts",
    "evals:check": "node --experimental-strip-types --no-warnings packages/evals/src/main.ts check",
    "evals:test": "pnpm --filter @capxul/evals test",
    "ops": "node --experimental-strip-types --no-warnings packages/ops/src/main.ts"
  },
  "devDependencies": {
    "effect": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
