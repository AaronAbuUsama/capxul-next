   "fields": {
    "from": "session_01S8RF7A5EFsECELJk2x94CG",
    "question": "Measure the plumbing now, or after telemetry lands?",
    "problem": "The run's plumbing fixes are ready to measure, but telemetry, which would show where the time goes, lands later.",
    "context": "A full run takes 27 minutes; the target is 5. Each measured run costs about one dollar of Cloudflare and Neon.",
    "rubric": [
     {
      "name": "Speed of learning",
      "why": "The sooner we see the gain, the sooner the next fix is chosen."
     },
     {
      "name": "Cost",
      "why": "The daily cap is ten dollars across all lanes."
     }
    ],
    "options": [
     {
      "key": "A",
      "title": "Measure now",
      "detail": "Run the full journeys tonight without telemetry.",
      "tradeoffs": "A number tonight, but no breakdown of where the time went."
     },
     {
      "key": "B",
      "title": "Wait for telemetry",
      "detail": "Measure once telemetry has landed in master.",
      "tradeoffs": "One complete measurement tomorrow; tonight is lost."
     }
    ],
    "recommended": "A",
    "because": "The number alone tells us whether the plumbing worked; the breakdown can follow on the next run.",
    "answer": {
     "own": "Measure now, but run it twice so we see the noise between runs before trusting the number."
    }
   }
  }
