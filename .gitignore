node_modules
packages/indexer/.ponder
*.zip
packages/portal/dist
packages/loop-ui/dist

# packages/frappe-app generated files
packages/frappe-app/**/__pycache__/
packages/frappe-app/*.egg-info/

# a run's log is kept on the machine that ran it; its results and evidence are committed
status/runs/*/run.log

# working data, never committed: loop run folders are written to var/runs/
var/

# TypeScript's incremental build record: `pnpm check` (tsc -b) writes one beside each tsconfig
*.tsbuildinfo

.DS_Store

# Amp-generated state (tracked lifecycle and service declarations stay visible).
.amp/portals/
.amp/in/
.amp/orb/
